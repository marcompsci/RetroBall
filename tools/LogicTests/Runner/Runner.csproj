<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity EditMode logic tests outside Unity using a minimal NUnit-compatible shim.
       The same test files compile against real NUnit inside the Unity Test Runner. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Logic/Logic.csproj" />
    <Compile Include="*.cs" />
    <Compile Include="../../../CallerRetroBall/Assets/Tests/EditMode/Logic/**/*.cs" />
  </ItemGroup>
</Project>
