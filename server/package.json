{
  "name": "retrohoops-server",
  "private": true,
  "version": "1.0.0",
  "description": "Retro Hoops Live backend: Game Center sign-in, App Store subscription checks, server-side Live ratings. Cloudflare Workers + D1.",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute retrohoops --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute retrohoops --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
