<!-- Retro Hoops: keep all of our own code when release builds strip unused code (ReleaseTools.EnsureSizeSettings).
     Save files are read and written by JsonUtility and MiniJson, so nothing of ours may be stripped.
     ignoreIfMissing: package assemblies are kept when present, and never fail the linker if a package renames them. -->
<linker>
  <assembly fullname="RetroHoops.Logic" preserve="all"/>
  <assembly fullname="RetroHoops.Runtime" preserve="all"/>
  <assembly fullname="Unity.InputSystem" preserve="all" ignoreIfMissing="1"/>
  <assembly fullname="Unity.TextMeshPro" preserve="all" ignoreIfMissing="1"/>
</linker>
